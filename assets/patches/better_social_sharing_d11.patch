 /**
  * Hook implementations for better_social_sharing_buttons.
@@ -79,6 +80,16 @@ class BetterSocialSharingButtonsHooks {
   public static function preprocessBetterSocialSharingButtons(&$variables): void {
     $icon_set = $variables['items']['iconset'] ?? \Drupal::config('better_social_sharing_buttons.settings')->get('iconset');
     $variables['social_buttons_sprite'] = Url::fromUri('internal:/' . \Drupal::service('extension.list.module')->getPath('better_social_sharing_buttons') . '/assets/dist/sprites/' . $icon_set . '.svg')->toString();
+
+    // Share the URL stored in a configured link field instead of the node URL.
+    $preferred = \Drupal::config('better_social_sharing_buttons.settings')->get('preferred_url');
+    $node = \Drupal::routeMatch()->getParameter('node');
+    if ($preferred && $node instanceof NodeInterface && $node->hasField($preferred)
+      && $node->get($preferred)->getFieldDefinition()->getType() === 'link'
+      && ($link = $node->get($preferred)->first())) {
+      $variables['items']['page_url'] = $link->getUrl()->setAbsolute()->toString();
+      $variables['#cache']['max-age'] = 0;
+    }
   }
 
