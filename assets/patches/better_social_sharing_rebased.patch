       '#default_value' => $config->get('node_field') ?: FALSE,
     ];
 
+    $form['use_url_field'] = [
+            '#type' => 'textfield',
+            '#title' => $this->t('Url Field to use'),
+            '#default_value' => $config->get('preferred_url') ?: '',
+            '#description' => $this->t('Prefer this field over the entity url'),
+            '#required' => FALSE,
+          ];
+
     return parent::buildForm($form, $form_state);
   }
 
@@ -150,6 +158,7 @@ class BetterSocialSharingButtonsForm extends ConfigFormBase {
     $config->set('print_css', $form_state->getValue('print_css'));
     $config->set('iconset', $form_state->getValue('iconset'));
     $config->set('node_field', $form_state->getValue('node_field'));
+    $config->set('preferred_url', $form_state->getValue('use_url_field'));
     $config->save();
     $this->messenger()->addMessage($this->t("Configuration saved!"));
   }
