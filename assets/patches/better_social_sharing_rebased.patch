diff --git a/better_social_sharing_buttons.libraries.yml b/better_social_sharing_buttons.libraries.yml
index 327df23..7bf5edd 100644
--- a/better_social_sharing_buttons.libraries.yml
+++ b/better_social_sharing_buttons.libraries.yml
@@ -12,6 +12,7 @@ copy-current-url:
   dependencies:
     - core/drupal
     - core/once
+    - core/drupalSettings
 
 bluesky:
   version: 1.x
diff --git a/better_social_sharing_buttons.module b/better_social_sharing_buttons.module
index e1e58ac..a15d345 100644
--- a/better_social_sharing_buttons.module
+++ b/better_social_sharing_buttons.module
@@ -10,6 +10,9 @@ use Drupal\Core\Entity\EntityInterface;
 use Drupal\Core\Routing\RouteMatchInterface;
 use Drupal\Core\Url;
 use Drupal\node\Entity\NodeType;
+use Drupal\node\NodeInterface;
+use Symfony\Component\Validator\Constraints\IsNull;
+
 
 /**
  * Implements hook_theme().
@@ -100,8 +103,34 @@ function better_social_sharing_buttons_preprocess_better_social_sharing_buttons(
     $icon_set = \Drupal::config('better_social_sharing_buttons.settings')->get('iconset');
   }
   $variables['social_buttons_sprite'] = Url::fromUri('internal:/' . \Drupal::service('extension.list.module')->getPath('better_social_sharing_buttons') . '/assets/dist/sprites/' . $icon_set . '.svg')->toString();
+
+  if (($node = \Drupal::routeMatch()->getParameter('node'))) {
+    $config = \Drupal::config('better_social_sharing_buttons.settings');
+    /* Check if we aren't required to use a slightly different URL */
+    if ($config->get('preferred_url')) {
+      if ($node instanceof NodeInterface) {
+        $preferred = $config->get('preferred_url');
+        $field_type = $node->get($preferred)->getFieldDefinition()->getType();
+        if($field_type === "link"){
+          $temp = $node->get($preferred)->first();
+          if(!is_null($temp)){
+            $url = $temp->getUrl()->toString();
+          }
+        }
+        
+        if (isset($url)) {
+          $variables['over_rides']['preferred_url'] = $url;
+          $variables['#cache']['max-age'] = 0;
+          $variables['#attached']['library'][] = 'copy-current-url/copy-current-url-js';
+          // pass variable to Drupal.Settings
+          $variables['#attached']['drupalSettings']['url'] = $url;
+        }
+      }
+    }
+  }
 }
 
+
 /**
  * Implements hook_help().
  *
