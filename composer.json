{
   "name": "islandora/islandora-sandbox",
   "description": "Project template for Drupal 8 projects with composer",
   "version": "3.0.0",
   "type": "project",
   "license": "GPL-2.0-or-later",
   "authors": [
      {
         "name": "Islandora Foundation",
         "role": "Owner",
         "email": "community@islandora.ca"
      }
   ],
   "repositories": [
      {
         "type": "composer",
         "url": "https://packages.drupal.org/8"
      },
      {
         "type": "package",
         "package": {
            "name": "library/pdf.js",
            "version": "2.10.377",
            "type": "drupal-library",
            "dist": {
               "url": "https://github.com/mozilla/pdf.js/releases/download/v2.10.377/pdfjs-2.10.377-dist.zip",
               "type": "zip"
            }
         }
      },
      {
         "type": "package",
         "package": {
            "name": "library/masonry",
            "version": "3.3.2",
            "type": "drupal-library",
            "dist": {
               "url": "https://github.com/desandro/masonry/archive/v3.3.2.zip",
               "type": "zip"
            }
         }
      },
      {
         "type": "package",
         "package": {
            "name": "library/timeline3",
            "version": "3.8.18",
            "type": "drupal-library",
            "dist": {
               "url": "https://github.com/digitalutsc/islandora_lite_installation/raw/main/libs/timeline3.zip",
               "type": "zip"
            }
         }
      },
      {
         "type": "package",
         "package": {
            "name": "library/jsoneditor",
            "version": "6.0.0",
            "type": "drupal-library",
            "dist": {
               "url": "https://github.com/josdejong/jsoneditor/archive/refs/tags/v6.0.0.zip",
               "type": "zip"
            }
         }
      },      
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/islandora_iiif"
      },       
      {
         "type": "vcs",
         "url": "https://github.com/discoverygarden/islandora_hocr"
      }, 
      {
         "type": "vcs",
         "url": "https://github.com/Born-Digital-US/islandora_iiif_hocr"
      }, 
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/facets_year_range"
      },
      {
         "type": "vcs",
         "url": "https://github.com/Islandora-Labs/views_nested_details"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/ableplayer_extend"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/islandora_breadcrumbs"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/islandora_search_processor"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/islandora_object_thumbnail"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/islandora_site_name"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/termwithuri_condition"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/media_fits"
      },
      {
         "type": "vcs",
         "url": "https://github.com/digitalutsc/islandora_iiif_hocr_extend"
      }
   ],
   "require": {
      "php": ">=8.3",
      "born-digital/islandora_iiif_hocr": "2.0.7",
      "composer/installers": "^2.0",
      "cweagans/composer-patches": "^1.9@dev",
      "digitalutsc/group_solr": "^1.0",
      "digitalutsc/islandora_group": "^2.0",
      "digitalutsc/private_files_adapter": "^1.0",
      "discoverygarden/dgi_fixity": "^1.4.6",
      "discoverygarden/islandora_hocr": "v1.4.3",
      "drupal/ableplayer": "3.4.3",
      "drupal/admin_toolbar": "^3.6.3",
      "drupal/advanced_search": "2.4.5",
      "drupal/advancedqueue": "^1.7",
      "drupal/advancedqueue_runner": "^2.0.5",
      "drupal/archive_list_contents": "^2.0",
      "drupal/asset_injector": "^2.21",
      "drupal/better_social_sharing_buttons": "5.0.0",
      "drupal/citation_select": "^2.1.1",
      "drupal/config_update": "^2.0@alpha",
      "drupal/context": "^5@RC",
      "drupal/context_ui": "^5@RC",
      "drupal/controlled_access_terms": "^2.6",
      "drupal/core-composer-scaffold": "^11.4",
      "drupal/core-recommended": "^11.4",
      "drupal/csvfile_formatter": "^1.0.26",
      "drupal/devel": "^5.5",
      "drupal/facets": "^2.0.10",
      "drupal/field_group": "^4.0",
      "drupal/field_permissions": "^1.5",
      "drupal/filemime": "^2.0.2",
      "drupal/filter_perms": "^2.0.3",
      "drupal/fontawesome": "^3.0",
      "drupal/fullcalendar_solr": "^1.0.2",
      "drupal/geolocation": "^3.15",
      "drupal/islandora_mirador": "^3.0.1",
      "drupal/json_field": "^1.7",
      "drupal/json_field_processor": "1.0.x-dev@dev",
      "drupal/jsonld": "^3.0.5",
      "drupal/jwt": "^2.4",
      "drupal/media_file_delete": "^1.3.2",
      "drupal/media_library_edit": "^3.0.5",
      "drupal/media_thumbnails": "2.0",
      "drupal/media_thumbnails_jp2": "^1.0.1",
      "drupal/media_thumbnails_pdf": "^2.0.1",
      "drupal/media_thumbnails_tiff": "^1.0",
      "drupal/media_thumbnails_video": "^2.0.2",
      "drupal/migrate_plus": "^6.0.10",
      "drupal/migrate_source_csv": "^3.8",
      "drupal/openseadragon": "^3.0.1",
      "drupal/pathauto": "^1.15",
      "drupal/pdf": "^1.3",
      "drupal/replaywebpage": "^1.0.1",
      "drupal/rest_oai_pmh": "^2.3.3",
      "drupal/restui": "^1.22",
      "drupal/search_api_location": "^1.0@alpha",
      "drupal/search_api_solr": "^4.4",
      "drupal/taxonomy_manager": "^2.0.23",
      "drupal/term_condition": "^2.0.5",
      "drupal/triplestore_indexer": "^2.1.2",
      "drupal/views_bulk_edit": "^3.0.1",
      "drupal/views_bulk_operations": "^4.4.8",
      "drupal/views_data_export": "^1.10",
      "drupal/views_field_view": "^1.0",
      "drupal/views_flipped_table": "3.0.0",
      "drupal/views_timelinejs": "^4.2.2",
      "drush/drush": "^13",
      "islandora/islandora_iiif": "^1.0",
      "islandora/views_nested_details": "^1.1",
      "islandora_lite/ableplayer_extend": "^1.0",
      "islandora_lite/facets_year_range": "1.0.1",
      "islandora_lite/islandora_breadcrumbs": "^1.0",
      "islandora_lite/islandora_object_thumbnail": "^1.0",
      "islandora_lite/islandora_search_processor": "^1.0",
      "islandora_lite/islandora_site_name": "^1.1",
      "islandora_lite/termwithuri_condition": "^1.0",
      "library/masonry": "3.3.2",
      "library/pdf.js": "2.10.377",
      "library/timeline3": "3.8.18",
      "library/jsoneditor": "6.0.0",
      "mjordan/islandora_workbench_integration": "1.2.1",
      "vlucas/phpdotenv": "^2.4",
      "webflo/drupal-finder": "^1.3",        
      "wikimedia/composer-merge-plugin": "^2.0",
      "zaporylie/composer-drupal-optimizations": "^1.2",
      "digitalutsc/media_fits": "^1.0",      
      "drupal/imagemagick": "^5.0.1",
      "islandora_lite/islandora_iiif_hocr_extend": "^1.0", 
      "drupal/group" :"3.3.5",
      "drupal/hal": "^2.0.5",
      "drupal/rdf": "^3.0@beta"
   },
   "require-dev": {
      "phpunit/phpunit": "^11"
   },
   "conflict": {
      "drupal/drupal": "*",
      "drupal/core": "<=8"
   },
   "minimum-stability": "stable",
   "prefer-stable": true,
   "config": {
      "audit": {
         "ignore": {}
      },
      "discard-changes": true,
      "sort-packages": true,
      "preferred-install": "dist",
      "allow-plugins": {
         "composer/installers": true,
         "drupal/core-composer-scaffold": true,
         "drupal/core-project-message": true,
         "cweagans/composer-patches": true,
         "oomphinc/composer-installers-extender": true,
         "drupal/console-extend-plugin": true,
         "zaporylie/composer-drupal-optimizations": true,
         "wikimedia/composer-merge-plugin": true,
         "dealerdirect/phpcodesniffer-composer-installer": true,
         "php-http/discovery": true,
         "symfony/runtime": true
      }
   },
   "autoload": {
      "classmap": [
         "scripts/composer/ScriptHandler.php"
      ],
      "files": [
         "load.environment.php"
      ]
   },
   "scripts": {
      "pre-install-cmd": [
         "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
      ],
      "pre-update-cmd": [
         "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
      ],
      "post-install-cmd": [
         "@composer drupal:scaffold",
         "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
         "rm -rf web/modules/contrib/islandora"
      ],
      "post-update-cmd": [
         "@composer drupal:scaffold",
         "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
         "@patch-files",
         "DrupalProject\\composer\\ScriptHandler::applyDrupalPatches",
         "rm -rf web/modules/contrib/islandora"
      ],
      "patch-files": [
         "php -r \"copy('https://raw.githubusercontent.com/digitalutsc/islandora_lite_installation/main/templates/mods.html.twig', './web/modules/contrib/rest_oai_pmh/templates/mods.html.twig');\""
      ]
   },
   "extra": {
      "drupal-scaffold": {
         "locations": {
            "web-root": "web/"
         },
         "file-mapping": {
            "[web-root]/sites/default/settings.php": {
               "mode": "append",
               "default": "web/core/assets/scaffold/files/default.settings.php",
               "append": "assets/patches/default_settings.txt"
            }
         }
      },
      "installer-paths": {
         "web/core": [
            "type:drupal-core"
         ],
         "web/libraries/{$name}": [
            "type:drupal-library"
         ],
         "web/modules/contrib/{$name}": [
            "type:drupal-module"
         ],
         "web/profiles/contrib/{$name}": [
            "type:drupal-profile"
         ],
         "web/themes/contrib/{$name}": [
            "type:drupal-theme"
         ],
         "drush/Commands/contrib/{$name}": [
            "type:drupal-drush"
         ]
      },
      "composer-exit-on-patch-failure": true,
      "patchLevel": {
         "drupal/core": "-p2"
      },
      "enable-patching": true,
      "patches": {
         "mjordan/islandora_workbench_integration": {
            "workbench_integration.patch": "assets/patches/workbench_integration_d11.patch"
         },
         "drupal/views_flipped_table": {
            "accessibility_views_flipped_table_convert_to_layout_table.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/accessibility_views_flipped_table_convert_to_layout_table.patch"
         },
         "drupal/ableplayer": {
            "ableplayer_fixentitydisplayissue.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/ableplayer_fixentitydisplayissue.patch"
         },
         "drupal/better_social_sharing_buttons":{
           "custom_link.patch": "assets/patches/better_social_sharing_d11.patch"
         },
         "discoverygarden/islandora_hocr": {
            "islandora_hocr_lite_1.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/islandora_hocr_lite.patch"
         },
         "born-digital/islandora_iiif_hocr": {
            "islandora_iiif_hocr_lite.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/islandora_iiif_hocr_lite.patch"
         },
         "drupal/islandora_mirador": {
            "islandora_mirador_lite.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/islandora_mirador_lite.patch"
         },
         "drupal/media_thumbnails": {
            "media_thumbnail.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/media_thumbnails_march_17_2025.patch"
         },
         "drupal/group": {
            "group.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/view_batch_export_issue.patch"
         },
         "drupal/advanced_search": {
            "advanced_search_issue_96.patch": "https://raw.githubusercontent.com/digitalutsc/islandora-lite-site/refs/heads/2.x/assets/patches/advanced_search_issue_96.patch"
         },
         "drupal/controlled_access_terms": {
            "controlled_access_term_reversed_typerelation.patch": "https://raw.githubusercontent.com/digitalutsc/dsu_sites_config/refs/heads/main/all/patches/controlled_access_term_reversed_typerelation.patch"
         }
      },
      "merge-plugin": {
         "include": [
            "composer_site.json"
         ]
      }
   }
 }
